{
  "name": "montblank-portfolio-v4",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "images": "node scripts/build-images.mjs",
    "predev": "npm run fonts && npm run images",
    "prebuild": "npm run fonts && npm run images",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name montblank-portfolio --branch main",
    "astro": "astro"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.81",
    "astro": "^7.4.1",
    "astro-adapter-cloudflare-pages": "^0.3.0",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  }
}
