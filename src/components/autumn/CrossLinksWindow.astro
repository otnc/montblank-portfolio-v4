---
import Window from '@/components/autumn/Window.astro';
import { SITE_ORIGIN, crossLinkRequest, crossLinks, profile } from '@/data/profile';

// Generated by scripts/build-images.mjs.
const banner = { path: '/banners/normal.png', width: 200, height: 40 };
const bannerHtml = `<a href="${SITE_ORIGIN}/"><img src="${SITE_ORIGIN}${banner.path}" width="${banner.width}" height="${banner.height}" alt="${profile.name}"></a>`;
const hostname = (url: string) => new URL(url).hostname;
---

<Window title="cross-links.txt" class="window--right">
	<h2>Cross Links</h2>
	<ul class="partners">
		{
			crossLinks.map((link) => (
				<li>
					<a href={link.url} target="_blank" rel="noreferrer">
						{link.author}
					</a>
					<span class="muted">{hostname(link.url)}</span>
				</li>
			))
		}
	</ul>

	<h3 class="section-gap">相互リンクの申請</h3>
	<p><a class="pixel-button" href={crossLinkRequest.url} target="_blank" rel="noreferrer">Request</a></p>
	<ul class="requirements">
		{crossLinkRequest.requirements.map((requirement) => <li>{requirement}</li>)}
	</ul>

	<h3 class="section-gap">このサイトのバナー</h3>
	<img class="banner" src={banner.path} width={banner.width} height={banner.height} alt={`${profile.name} のバナー`} />
	<code class="banner-code">{bannerHtml}</code>
</Window>

<style>
	.partners {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 4px 16px;
		margin-top: 8px;
	}

	.partners li {
		display: grid;
	}

	.section-gap {
		margin-top: 24px;
	}

	.requirements {
		margin-top: 12px;
	}

	.requirements li::before {
		content: '- ';
		color: var(--accent);
	}

	.banner {
		display: block;
		margin-top: 8px;
		image-rendering: pixelated;
	}

	/* One click selects the whole snippet, ready to copy. */
	.banner-code {
		display: block;
		margin-top: 8px;
		padding: 4px 8px;
		background: var(--ink);
		color: var(--cream);
		font-family: var(--font-body);
		overflow-wrap: anywhere;
		user-select: all;
	}
</style>
