---
import Window from '@/components/autumn/Window.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { accounts, profile, tagGroups } from '@/data/profile';
---

<Window title="profile.txt" class="window--left">
	<div class="profile">
		<img class="profile__avatar" src={profile.avatar} alt="" width="160" height="160" />
		<div class="profile__intro">
			<h1>{profile.name}</h1>
			<p>{profile.bio}</p>
			<ul class="profile__meta">
				<li><span class="muted">誕生日</span> {profile.birthday}</li>
				<li><span class="muted">所在地</span> {profile.location}</li>
			</ul>
		</div>
	</div>

	<ul class="catchphrases">
		{profile.catchphrases.map((phrase) => <li>{phrase}</li>)}
	</ul>

	<dl class="groups">
		{
			tagGroups.map((group) => (
				<div>
					<dt>{group.heading}</dt>
					<dd>
						<ul class="tags">
							{group.items.map((item) => (
								<li class="tag">{item}</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>

	<h2>SNS</h2>
	<ul class="accounts">
		{
			accounts.map((account) => (
				<li>
					<a href={account.url} target="_blank" rel="noreferrer">
						<PixelIcon name={account.icon} />
						<span>{account.label}</span>
						{account.handle && <span class="muted accounts__handle">{account.handle}</span>}
					</a>
				</li>
			))
		}
	</ul>
</Window>

<style>
	.profile {
		display: flex;
		gap: 24px;
		align-items: flex-start;
	}

	.profile__avatar {
		flex: none;
		width: 160px;
		height: 160px;
		outline: 3px solid var(--ink);
		image-rendering: pixelated;
	}

	.profile__intro {
		display: grid;
		gap: 8px;
	}

	.profile__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 24px;
	}

	.catchphrases {
		display: grid;
		gap: 4px;
		margin: 24px 0;
		padding: 12px 16px;
		background: var(--marron-light);
		font-family: var(--font-heading);
		font-size: 24px;
		line-height: 36px;
	}

	.catchphrases li::before {
		content: '> ';
		color: var(--accent);
	}

	.groups {
		display: grid;
		gap: 12px;
		margin: 0 0 24px;
	}

	.groups dt {
		color: var(--heading);
	}

	.groups dd {
		margin: 4px 0 0;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.accounts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 4px 16px;
		margin-top: 8px;
	}

	.accounts a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 2px 8px;
		color: var(--ink);
		text-decoration: none;
	}

	.accounts a:hover,
	.accounts a:focus-visible {
		background: var(--marron-light);
	}

	.accounts__handle {
		margin-left: auto;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	@media (max-width: 640px) {
		.profile {
			flex-direction: column;
			align-items: center;
		}

		/* PixelMplus12 only stays crisp at multiples of 12px, so the smaller size switches to the body font. */
		.catchphrases {
			font-family: var(--font-body);
			font-size: 20px;
			line-height: 30px;
		}
	}
</style>
