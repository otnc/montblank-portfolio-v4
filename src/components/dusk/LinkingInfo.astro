---
/**
 * What someone linking to this site needs: its name, title and URL, then the icon and banners to hotlink.
 * Shown under Links on the top page and at the bottom of /links.
 */
import { SITE_ORIGIN, profile } from '@/data/profile';

// Generated by scripts/build-images.mjs.
// The thumbnail is shown at half size, which keeps its 6px dots square.
const ownBanners = [
	{ path: '/thumbnail.png', width: 1200, height: 630, displayWidth: 600 },
	{ path: '/banners/normal.png', width: 200, height: 40 },
];
const bannerHtml = (banner: (typeof ownBanners)[number]) =>
	`<a href="${SITE_ORIGIN}/"><img src="${SITE_ORIGIN}${banner.path}" width="${banner.width}" height="${banner.height}" alt="${profile.siteName}"></a>`;
const siteInfo = [
	{ label: 'Name', value: profile.name },
	{ label: 'Site', value: profile.siteName },
	{ label: 'URL', value: SITE_ORIGIN, href: `${SITE_ORIGIN}/` },
];
---

<h3 id="linking-info" class="section-gap">相互リンクする方へ</h3>
<dl class="site-info">
	{
		siteInfo.map((item) => (
			<div>
				<dt>{item.label}</dt>
				<dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
				<dd>
					<button class="copy-button" type="button" data-copy={item.value} aria-label={`Copy ${item.label}`}>
						Copy
					</button>
				</dd>
			</div>
		))
	}
</dl>
<p class="visually-hidden" role="status" data-copy-status></p>

<h3 id="icon-and-banners" class="section-gap">アイコン・バナー</h3>
<p class="muted">直リンクして大丈夫です。</p>
<ul class="banners">
	<li>
		<img class="own-icon" src={profile.icon} width="200" height="200" alt={`${profile.name} のアイコン (400x400)`} />
		<code class="banner-code">{`${SITE_ORIGIN}${profile.icon}`}</code>
	</li>
	{
		ownBanners.map((banner) => (
			<li>
				<img
					src={banner.path}
					width={banner.displayWidth ?? banner.width}
					height={((banner.displayWidth ?? banner.width) / banner.width) * banner.height}
					alt={`${profile.name} のバナー (${banner.width}x${banner.height})`}
				/>
				<code class="banner-code">{bannerHtml(banner)}</code>
			</li>
		))
	}
</ul>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		const status = button.closest('dl')?.nextElementSibling;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
			} catch {
				return;
			}
			button.textContent = 'Copied';
			if (status) status.textContent = `${button.dataset.copy} をコピーしました`;
			setTimeout(() => {
				button.textContent = 'Copy';
			}, 1500);
		});
	}
</script>

<style>
	.section-gap {
		margin-top: 24px;
		color: var(--heading);
	}

	/* One grid for all rows, so the copy buttons line up in a column after the longest value. */
	.site-info {
		display: grid;
		grid-template-columns: 4em minmax(0, max-content) auto;
		align-items: center;
		gap: 4px 16px;
		margin-top: 8px;
	}

	.site-info div {
		display: contents;
	}

	.site-info dt {
		color: var(--heading);
	}

	.site-info dd {
		margin: 0;
		overflow-wrap: anywhere;
	}

	.copy-button {
		min-width: 6em;
		padding: 0 8px;
		border: 3px solid var(--ink);
		background: none;
		color: var(--ink);
		font: inherit;
		cursor: pointer;
		transition: transform 0.12s steps(2);
	}

	.copy-button:hover,
	.copy-button:focus-visible {
		background: var(--marron-light);
		color: var(--ink);
	}

	.copy-button:active {
		transform: translateY(2px);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.banners {
		display: grid;
		gap: 16px;
		margin-top: 8px;
	}

	.banners li {
		display: grid;
		gap: 8px;
	}

	.banners img {
		display: block;
		max-width: 100%;
		height: auto;
		image-rendering: pixelated;
	}

	/* The icon is a dithered line drawing rather than dot art, so it scales smoothly. */
	.banners .own-icon {
		image-rendering: auto;
	}

	/* One click selects the whole snippet, ready to copy. */
	.banner-code {
		display: block;
		padding: 4px 8px;
		background: var(--ink);
		color: var(--cream);
		font-family: var(--font-body);
		overflow-wrap: anywhere;
		user-select: all;
	}
</style>
