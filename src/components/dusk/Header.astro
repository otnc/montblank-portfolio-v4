---
import PixelIcon from '@/components/PixelIcon.astro';
import { profile, writingSites } from '@/data/profile';
---

<header class="header">
	<a class="header__logo" href="/">{profile.name}</a>
	<nav aria-label="記事">
		<ul class="header__links">
			{
				writingSites.map((site) => (
					<li>
						<a href={site.url} target="_blank" rel="noreferrer">
							<PixelIcon name={site.icon} scale={2} />
							<span>{site.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	/* Sits on the hero's sky. */
	.header {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
		width: 100%;
		max-width: 1072px;
		padding: 16px;
		translate: -50% 0;
	}

	.header__logo,
	.header__links a {
		color: var(--cream) !important;
		text-decoration: none;
		text-shadow: 3px 3px 0 var(--ink);
	}

	.header__logo {
		font-family: var(--font-heading);
		font-size: 24px;
		line-height: 36px;
	}

	.header__links {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 16px;
	}

	.header__links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		transition: transform 0.12s steps(2);
	}

	.header__links :global(.pixel-icon) {
		filter: drop-shadow(3px 3px 0 var(--ink));
	}

	.header__links a:hover,
	.header__links a:focus-visible {
		transform: translateY(-3px);
		text-decoration: underline;
	}
</style>
