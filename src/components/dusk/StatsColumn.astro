---
/**
 * Stars, merged pull requests and issues stacked on the right of a repository row, as portfolio-v3 showed them,
 * each with its own pixel icon. A count of none, or one that is unknown, shows as "-".
 */
import { formatCompact, formatCount } from '@/lib/format';

interface Props {
	stars: number | null;
	merged: number | null;
	issues: number | null;
}

const { stars, merged, issues } = Astro.props;

const stats = [
	{ icon: 'star', size: 21, value: stars, label: 'stars' },
	{ icon: 'merge', size: 27, value: merged, label: 'merged pull requests' },
	{ icon: 'issue', size: 21, value: issues, label: 'issues' },
];
---

<dl class="stats">
	{
		stats.map((stat) => (
			<div title={stat.value ? `${formatCount(stat.value)} ${stat.label}` : undefined}>
				<dt>
					<img src={`/pixel/${stat.icon}.svg`} width={stat.size} height={stat.size} alt="" />
					<span class="visually-hidden">{stat.label}</span>
				</dt>
				<dd>{stat.value ? formatCompact(stat.value) : '-'}</dd>
			</div>
		))
	}
</dl>

<style>
	.stats {
		display: grid;
		flex: none;
		margin: 0;
	}

	.stats div {
		display: grid;
		grid-template-columns: 27px 60px;
		align-items: center;
		gap: 6px;
	}

	.stats dt {
		display: grid;
		place-items: center;
	}

	.stats dt img {
		display: block;
	}

	.stats dd {
		margin: 0;
		text-align: right;
	}
</style>
