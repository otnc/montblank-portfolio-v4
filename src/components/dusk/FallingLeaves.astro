---
/**
 * Leaves drifting down over a section. Each leaf falls in hard steps and flips between its two mirrored frames to flutter; pixel art is never rotated.
 * The parent must be positioned; the leaves fill it.
 */
import { pixelPaths } from '@/lib/pixel-path';

interface Props {
	count: number;
	seed: number;
}

const { count, seed } = Astro.props;

const MAPLE = ['...1...', '.1.1.1.', '.11111.', '1111111', '.11111.', '..111..', '...2...'];
const GINKGO = ['111111', '.1111.', '..11..', '..2...'];
const KINDS = [
	{ rows: MAPLE, colors: ['#e0573a', '#5a2a1a'] },
	{ rows: MAPLE, colors: ['#9cb05a', '#46602e'] },
	{ rows: MAPLE, colors: ['#f08a3a', '#5a2a1a'] },
	{ rows: GINKGO, colors: ['#e8b23a', '#7a5a1a'] },
];

let state = seed;
const random = () => {
	state = (state * 1664525 + 1013904223) % 4294967296;
	return state / 4294967296;
};

const leaves = Array.from({ length: count }, (_, index) => {
	const kind = KINDS[index % KINDS.length];
	return {
		kind,
		left: Math.round(random() * 100),
		duration: (8 + random() * 8).toFixed(1),
		delay: (-random() * 16).toFixed(1),
		sway: (1.2 + random() * 1.4).toFixed(1),
		drift: Math.round((random() - 0.5) * 30) * 3,
	};
});
---

<div class="leaves" aria-hidden="true">
	{
		leaves.map((leaf) => (
			<span class="leaf" style={`left:${leaf.left}%;--duration:${leaf.duration}s;--delay:${leaf.delay}s;--sway:${leaf.sway}s;--drift:${leaf.drift}px`}>
				<svg
					width={leaf.kind.rows[0].length * 3}
					height={leaf.kind.rows.length * 3}
					viewBox={`0 0 ${leaf.kind.rows[0].length} ${leaf.kind.rows.length}`}
					shape-rendering="crispEdges"
				>
					{pixelPaths(leaf.kind.rows, leaf.kind.colors).map((path) => (
						<path fill={path.fill} d={path.d} />
					))}
				</svg>
			</span>
		))
	}
</div>

<style>
	.leaves {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.leaf {
		position: absolute;
		top: -24px;
		animation: fall var(--duration) steps(48) var(--delay) infinite;
	}

	.leaf svg {
		display: block;
		animation:
			sway var(--sway) steps(4) infinite alternate,
			flip calc(var(--sway) / 2) steps(1) infinite;
	}

	@keyframes fall {
		to {
			transform: translate(var(--drift), calc(100cqh + 48px));
		}
	}

	@keyframes sway {
		from {
			translate: -9px 0;
		}
		to {
			translate: 9px 0;
		}
	}

	@keyframes flip {
		50% {
			scale: -1 1;
		}
	}

	.leaves {
		container-type: size;
	}

	@media (prefers-reduced-motion: reduce) {
		.leaves {
			display: none;
		}
	}
</style>
