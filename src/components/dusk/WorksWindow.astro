---
import LanguageBar from '@/components/dusk/LanguageBar.astro';
import StatsColumn from '@/components/dusk/StatsColumn.astro';
import Window from '@/components/dusk/Window.astro';
import Octocat from '@/components/Octocat.astro';
import { profile } from '@/data/profile';
import type { Work } from '@/lib/github';
import { spriteSvg } from '@/lib/pixel-grid';

interface Props {
	works: Work[] | null;
}

const { works } = Astro.props;
const repositoriesUrl = `https://github.com/${profile.handle}?tab=repositories`;
const pin = spriteSvg(['..ppp..', '..ppp..', '..ppp..', '.ppppp.', '...p...', '...p...', '...p...'], { p: '#c8442f' });
---

<Window title={`/${profile.handle}/works/`} class="window--right">
	<h2>Works</h2>
	{
		works && works.length > 0 ? (
			<ul class="works">
				{works.map((work) => (
					<li class="work">
						<div class="work__text">
							<h3>
								{work.pinned && (
									<span class="work__pin" title="Pinned">
										<Fragment set:html={pin} />
										<span class="visually-hidden">Pinned</span>
									</span>
								)}
								<a href={work.url} target="_blank" rel="noreferrer">
									{work.owner === profile.handle ? work.name : `${work.owner}/${work.name}`}
								</a>
							</h3>
							{work.description && (
								<p class="work__desc" title={work.description}>
									{work.description}
								</p>
							)}
							<LanguageBar languages={work.languages.slice(0, 3)} />
							{work.homepage && (
								<p class="work__links">
									<a href={work.homepage} target="_blank" rel="noreferrer">
										Link
									</a>
								</p>
							)}
						</div>
						<StatsColumn stars={work.stars} merged={work.mergedCount} issues={work.issueCount} />
					</li>
				))}
			</ul>
		) : (
			<p class="notice">GitHub から作品を読み込めませんでした。</p>
		)
	}
	<div class="more">
		<Octocat scale={3} />
		<a class="pixel-button" href={repositoriesUrl} target="_blank" rel="noreferrer">More</a>
	</div>
</Window>

<style>
	/* A scrolling list, one repository per row, with its counts in a column on the right. */
	.works {
		display: grid;
		margin-top: 8px;
		max-height: 660px;
		overflow-y: auto;
	}

	.work {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 8px;
		border-bottom: 3px dashed var(--marron-light);
	}

	.work:last-child {
		border-bottom: none;
	}

	.work:hover,
	.work:focus-within {
		background: var(--marron-light);
	}

	.work__text {
		display: grid;
		flex: 1;
		gap: 6px;
		min-width: 0;
	}

	.work h3 {
		display: flex;
		align-items: center;
		gap: 6px;
		overflow-wrap: anywhere;
	}

	.work h3 a {
		color: var(--ink);
	}

	.work__pin :global(svg) {
		display: block;
	}

	/* Descriptions come from GitHub and vary in length, so keep every row to two lines. */
	.work__desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		overflow-wrap: anywhere;
	}

	.more {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-top: 24px;
	}
</style>
