---
import Loading from '@/components/dusk/Loading.astro';
import Window from '@/components/dusk/Window.astro';
import WorksList from '@/components/dusk/WorksList.astro';
import Octocat from '@/components/Octocat.astro';
import { profile } from '@/data/profile';

const repositoriesUrl = `https://github.com/${profile.handle}?tab=repositories`;
---

<Window id="works" title={`/${profile.handle}/works/`} class="window--right">
	<h2>Works</h2>
	<WorksList server:defer>
		<Loading slot="fallback" height="660px" />
	</WorksList>
	<div class="more">
		<Octocat scale={3} />
		<a class="pixel-button" href={repositoriesUrl} target="_blank" rel="noreferrer">More</a>
	</div>
</Window>

<style>
	.more {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-top: 24px;
	}
</style>

<style is:global>
	/* The list, rendered by the WorksList server island. */
	/*
	 * A scrolling list, one repository per row, with its counts in a column on the right.
	 * It is the positioning context for anything absolute inside, so that scrolls with the list instead of stretching the page.
	 */
	.works {
		position: relative;
		display: grid;
		margin-top: 8px;
		max-height: 660px;
		overflow-y: auto;
	}

	.work {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 8px;
		border-bottom: 3px dashed var(--marron-light);
	}

	.work:last-child {
		border-bottom: none;
	}

	.work:hover,
	.work:focus-within {
		background: var(--marron-light);
	}

	.work__text {
		display: grid;
		flex: 1;
		gap: 6px;
		min-width: 0;
	}

	.work h3 {
		display: flex;
		align-items: center;
		gap: 6px;
		overflow-wrap: anywhere;
	}

	.work h3 a {
		color: var(--ink);
	}

	.work__pin img {
		display: block;
	}

	/* Descriptions come from GitHub and vary in length, so keep every row to two lines. */
	.work__desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		overflow-wrap: anywhere;
	}
</style>
