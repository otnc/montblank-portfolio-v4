---
/**
 * The life of the harbour behind the windows: ripples catching the light, Hakodate squid jetting through the water
 * on both sides of the path, and gulls passing overhead.
 * Positions are percentages of the page height, so they spread over any length of content.
 */
import { random, spriteSvg } from '@/lib/pixel-grid';

const rand = random(410);

const ripples = Array.from({ length: 70 }, () => ({
	left: Math.round(rand() * 100),
	top: Math.round(rand() * 1000) / 10,
	width: (2 + Math.floor(rand() * 4)) * 3,
	delay: (-rand() * 2).toFixed(2),
}));

// A squid swimming mantle first: fins at the top, two eyes, and its arms either trailing together or spread after a jet.
const SQUID_BODY = [
	'.....mm.....',
	'....mmmm....',
	'...mmmmmm...',
	'..mmmmmmmm..',
	'.mmmmmmmmmm.',
	'..mmmmmmmm..',
	'....mmmm....',
	'....msmm....',
	'....mmsm....',
	'....msmm....',
	'....mmmm....',
	'....mmsm....',
	'....emme....',
	'....mmmm....',
];
const SQUID_PALETTE = { m: '#f2d4cc', s: '#d08070', e: '#2a1a24', t: '#e8bfb4' };
const squid = [
	spriteSvg([...SQUID_BODY, '....t..t....', '...t.tt.t...', '...t.tt.t...', '....t..t....'], SQUID_PALETTE),
	spriteSvg([...SQUID_BODY, '...t.tt.t...', '..t..tt..t..', '.t...tt...t.', 't..........t'], SQUID_PALETTE),
];
// A tile of small wave marks scattered over the water, drifted slowly by CSS.
const WAVE_TILE = [
	'................................',
	'...ww.................ww........',
	'..w..w...............w..w.......',
	'................................',
	'................................',
	'..........ww....................',
	'.........w..w...................',
	'................................',
];
const waveSvg = spriteSvg(WAVE_TILE, { w: '#ffffff' }).replace('<svg ', '<svg xmlns="http://www.w3.org/2000/svg" ');
const waveTile = `url("data:image/svg+xml,${encodeURIComponent(waveSvg)}")`;
const squids = [
	{ left: 5, top: 8, delay: 0 },
	{ left: 91, top: 22, delay: -1.7 },
	{ left: 9, top: 41, delay: -3.1 },
	{ left: 87, top: 58, delay: -0.9 },
	{ left: 4, top: 74, delay: -2.4 },
	{ left: 92, top: 88, delay: -4.0 },
];
const GULL = [spriteSvg(['w.....w', '.w...w.', '..www..'], { w: '#f4ece0' }), spriteSvg(['.......', 'wwwwwww', '..www..'], { w: '#f4ece0' })];
---

<div class="life" aria-hidden="true" style={`--wave-tile:${waveTile}`}>
	{ripples.map((r) => <span class="ripple" style={`left:${r.left}%;top:${r.top}%;width:${r.width}px;--delay:${r.delay}s`} />)}
	{
		squids.map((s) => (
			<span class="squid" style={`left:${s.left}%;top:${s.top}%;--delay:${s.delay}s`}>
				<span class="squid__glide" set:html={squid[0]} />
				<span class="squid__jet" set:html={squid[1]} />
			</span>
		))
	}
	<div class="gull-layer">
		{
			[0, 1].map((index) => (
				<span class="gull" style={`top:${18 + index * 30}%;--duration:${22 + index * 9}s;--delay:${-index * 11}s`}>
					<span class="gull__a" set:html={GULL[0]} />
					<span class="gull__b" set:html={GULL[1]} />
				</span>
			))
		}
	</div>
</div>

<style>
	/* clip, not hidden: hidden would make this the scroll container and stop the sticky gull layer. */
	.life {
		position: absolute;
		inset: 0;
		overflow: clip;
		pointer-events: none;
	}

	.life > span {
		position: absolute;
	}

	.life :global(svg) {
		display: block;
	}

	/* Small wave marks all over the water, drifting sideways in hard steps. */
	.life::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--wave-tile) 0 0 / 96px 24px repeat;
		opacity: 0.12;
		animation: waves 12s steps(32) infinite;
	}

	@keyframes waves {
		to {
			background-position: 96px 0;
		}
	}

	/* Light on the water: a dash that wobbles sideways. */
	.ripple {
		height: 3px;
		background: #ffffff40;
		animation: wobble 1.4s steps(2) var(--delay) infinite alternate;
	}

	@keyframes wobble {
		to {
			translate: 6px 0;
		}
	}

	/*
	 * A squid jets upward in a quick burst with its arms spread, then trails them and sinks slowly back,
	 * the way squid swim. Both legs move in hard steps.
	 */
	.squid {
		animation: swim 4.8s var(--delay) infinite;
	}

	@keyframes swim {
		0% {
			translate: 0 0;
			animation-timing-function: steps(3);
		}
		12% {
			translate: 6px -54px;
			animation-timing-function: steps(12);
		}
		100% {
			translate: 0 0;
		}
	}

	.squid__jet {
		position: absolute;
		inset: 0;
	}

	.squid__glide,
	.squid__jet {
		animation: squid-glide 4.8s steps(1) var(--delay) infinite;
	}

	.squid__jet {
		animation-name: squid-jet;
	}

	/* With steps(1) each keyframe holds until the next, so both states are spelled out. */
	@keyframes squid-glide {
		0% {
			visibility: hidden;
		}
		14%,
		100% {
			visibility: visible;
		}
	}

	@keyframes squid-jet {
		0% {
			visibility: visible;
		}
		14%,
		100% {
			visibility: hidden;
		}
	}

	/* Gulls keep crossing wherever you are on the page. */
	.gull-layer {
		position: sticky;
		top: 0;
		height: 100vh;
	}

	.gull {
		position: absolute;
		left: 0;
		animation: fly var(--duration) steps(220) var(--delay) infinite;
	}

	@keyframes fly {
		from {
			transform: translateX(-40px);
		}
		to {
			transform: translateX(100vw);
		}
	}

	.gull__b {
		position: absolute;
		inset: 0;
	}

	.gull__a,
	.gull__b {
		animation: flap 0.6s steps(1) infinite;
	}

	.gull__b {
		animation-name: flap-b;
	}

	@keyframes flap {
		50% {
			visibility: hidden;
		}
	}

	@keyframes flap-b {
		0%,
		49% {
			visibility: hidden;
		}
	}

	@media (max-width: 1100px) {
		.squid {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.life *,
		.life::before,
		.life > span {
			animation: none !important;
		}

		.gull-layer {
			display: none;
		}
	}
</style>
