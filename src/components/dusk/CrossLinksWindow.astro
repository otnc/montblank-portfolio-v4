---
import Window from '@/components/dusk/Window.astro';
import { SITE_ORIGIN, crossLinkRequest, crossLinks, profile } from '@/data/profile';

// Generated by scripts/build-images.mjs.
// The thumbnail is shown at half size, which keeps its 6px dots square.
const ownBanners = [
	{ path: '/thumbnail.png', width: 1200, height: 630, displayWidth: 600 },
	{ path: '/banners/normal.png', width: 200, height: 40 },
];
const bannerHtml = (banner: (typeof ownBanners)[number]) =>
	`<a href="${SITE_ORIGIN}/"><img src="${SITE_ORIGIN}${banner.path}" width="${banner.width}" height="${banner.height}" alt="${profile.name}"></a>`;
const hostname = (url: string) => new URL(url).hostname;
---

<Window title="cross-links.txt" class="window--right">
	<h2>Cross Links</h2>
	<div class="partners-box">
		<ul class="partners">
			{
				crossLinks.map((link) => (
					<li class:list={[{ 'partners__wide': link.banner && link.banner.width > link.banner.height * 1.5 }]}>
						<a href={link.url} target="_blank" rel="noreferrer">
							{link.banner && (
								<img src={link.banner.src} width={link.banner.width / 2} height={link.banner.height / 2} alt="" loading="lazy" />
							)}
							<span class="partners__text">
								<span class="partners__name">{link.author}</span>
								<span class="muted">{hostname(link.url)}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<h3 class="section-gap">相互リンクの申請</h3>
	<p class="request"><a class="pixel-button" href={crossLinkRequest.url} target="_blank" rel="noreferrer">Request</a></p>
	<ul class="requirements">
		{crossLinkRequest.requirements.map((requirement) => <li>{requirement}</li>)}
	</ul>

	<h3 class="section-gap">このサイトのバナー</h3>
	<p class="muted">直リンクして大丈夫です。</p>
	<ul class="banners">
		{
			ownBanners.map((banner) => (
				<li>
					<img
						src={banner.path}
						width={banner.displayWidth ?? banner.width}
						height={((banner.displayWidth ?? banner.width) / banner.width) * banner.height}
						alt={`${profile.name} のバナー (${banner.width}x${banner.height})`}
					/>
					<code class="banner-code">{bannerHtml(banner)}</code>
				</li>
			))
		}
	</ul>
</Window>

<style>
	.partners-box {
		container-type: inline-size;
	}

	.partners {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
		gap: 8px 16px;
		margin-top: 8px;
	}

	.partners a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 6px 8px;
		color: var(--ink);
		text-decoration: none;
	}

	/* A wide banner takes two columns, so a row holds at most two partners when one of them has one. */
	@container (min-width: 600px) {
		.partners__wide {
			grid-column: span 2;
		}
	}

	/* Their images are photos and illustrations, not pixel art, so they keep smooth scaling. */
	.partners img {
		flex: none;
		height: 60px;
		width: auto;
		max-width: 60%;
		object-fit: contain;
		outline: 3px solid var(--ink);
		transition: transform 0.12s steps(2);
	}

	.partners a:hover img {
		transform: translateY(-3px);
	}

	.partners__text {
		display: grid;
		min-width: 0;
	}

	.partners a:hover,
	.partners a:focus-visible {
		background: var(--marron-light);
	}

	.partners__name {
		text-decoration: underline;
	}

	.banners img {
		display: block;
		max-width: 100%;
		height: auto;
		image-rendering: pixelated;
	}

	.section-gap {
		margin-top: 24px;
		color: var(--heading);
	}

	.requirements {
		margin-top: 12px;
	}

	.requirements li::before {
		content: '- ';
		color: var(--accent);
	}

	.request {
		margin-top: 8px;
	}

	.banners {
		display: grid;
		gap: 16px;
		margin-top: 8px;
	}

	.banners li {
		display: grid;
		gap: 8px;
	}

	/* One click selects the whole snippet, ready to copy. */
	.banner-code {
		display: block;
		padding: 4px 8px;
		background: var(--ink);
		color: var(--cream);
		font-family: var(--font-body);
		overflow-wrap: anywhere;
		user-select: all;
	}
</style>
