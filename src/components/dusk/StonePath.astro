---
/**
 * A stone-paved path down the middle of the harbour, under the column of windows, paved like Hachiman-zaka:
 * irregular, many-sided grey flagstones with dark joints and one straight strip of stone down the centre,
 * with a granite kerb on each side where the water begins. It darkens toward the bottom along with the water.
 * The flagstones are one repeating 96x64-dot tile, drawn in src/data/stone-path.ts and served as /pixel/stone-path.svg.
 */
---

<div class="path" aria-hidden="true">
	<span class="path__centre"></span>
</div>

<style>
	.path {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: min(1100px, 100%);
		translate: -50% 0;
		background:
			linear-gradient(transparent 0 25%, #2a1a3026 25% 50%, #2a1a3048 50% 75%, #1d142070 75% 100%),
			url('/pixel/stone-path.svg') 0 0 / calc(96 * var(--dot)) calc(64 * var(--dot)) repeat;
		/* Granite kerbs, then the quay edge dropping to the water. */
		border-inline: 12px solid #b8aca6;
		box-shadow:
			-9px 0 0 #3e3448,
			9px 0 0 #3e3448;
	}

	/* The straight strip of stone running down the middle of the slope, in short slabs. */
	.path__centre {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 18px;
		translate: -50% 0;
		background: repeating-linear-gradient(#a8a2a6 0 45px, #4e4a54 45px 48px);
		border-inline: 3px solid #4e4a54;
	}
</style>
