---
import Window from '@/components/dusk/Window.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { accounts, profile, tagGroups } from '@/data/profile';
import { spriteSvg } from '@/lib/pixel-grid';

const cake = spriteSvg(['...f...', '...y...', '.wwwww.', '.ppppp.', 'wwwwwww', 'ppppppp', 'bbbbbbb'], {
	f: '#e0573a',
	y: '#f6cc4a',
	w: '#fff4e2',
	p: '#e8a0a0',
	b: '#c99a6b',
});
const pin = spriteSvg(['.rrrr.', 'rrwrrr', 'rrrrrr', '.rrrr.', '..rr..', '..rr..', '...r..'], { r: '#c8442f', w: '#fff4e2' });
---

<Window title="about.txt - メモ帳" class="window--left">
	<h2>自己紹介</h2>
	<p class="bio">{profile.bio}</p>
	<ul class="meta">
		<li><Fragment set:html={cake} /><span class="visually-hidden">誕生日</span>{profile.birthday}</li>
		<li><Fragment set:html={pin} /><span class="visually-hidden">所在地</span>{profile.location}</li>
	</ul>

	<!-- A sticky note taped to the window. -->
	<ul class="note">
		{profile.catchphrases.map((phrase) => <li>{phrase}</li>)}
	</ul>

	<dl class="groups">
		{
			tagGroups.map((group) => (
				<div>
					<dt>{group.heading}</dt>
					<dd>
						<ul class="tags">
							{group.items.map((item) => (
								<li class="tag">{item}</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>

	<h3 class="sns-heading">SNS</h3>
	<ul class="accounts">
		{
			accounts.map((account) => (
				<li>
					<a href={account.url} target="_blank" rel="noreferrer">
						<PixelIcon name={account.icon} />
						<span>{account.label}</span>
						{account.handle && <span class="muted accounts__handle">{account.handle}</span>}
					</a>
				</li>
			))
		}
	</ul>
</Window>

<style>
	.bio {
		margin-top: 8px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 24px;
		margin-top: 12px;
	}

	.meta li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.note {
		position: relative;
		display: grid;
		gap: 4px;
		width: fit-content;
		max-width: 100%;
		margin: 32px auto 32px 8px;
		padding: 20px 24px 16px;
		background: #f6d878;
		font-family: var(--font-heading);
		font-size: 24px;
		line-height: 36px;
		filter: drop-shadow(6px 6px 0 #00000033);
		transform: translateY(0);
		transition: transform 0.15s steps(2);
	}

	/* Masking tape across the top edge. */
	.note::before {
		content: '';
		position: absolute;
		left: 50%;
		top: -9px;
		width: 72px;
		height: 18px;
		translate: -50% 0;
		background: repeating-linear-gradient(90deg, #e8cba3cc 0 6px, #d8b88acc 6px 12px);
	}

	.note:hover {
		transform: translateY(-3px);
	}

	.note li::before {
		content: '> ';
		color: var(--accent);
	}

	.groups {
		display: grid;
		gap: 12px;
		margin: 0 0 24px;
	}

	.groups dt {
		color: var(--heading);
	}

	.groups dd {
		margin: 4px 0 0;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tag {
		transition: transform 0.12s steps(2);
	}

	.tag:hover {
		transform: translateY(-3px);
		background: var(--ginkgo);
	}

	.sns-heading {
		color: var(--heading);
	}

	/* At most two columns, so handles stay readable. */
	.accounts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4px 16px;
		margin-top: 8px;
	}

	.accounts li,
	.accounts a {
		min-width: 0;
	}

	.accounts a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 2px 8px;
		color: var(--ink);
		text-decoration: none;
	}

	.accounts a:hover,
	.accounts a:focus-visible {
		background: var(--marron-light);
	}

	.accounts a:hover :global(.pixel-icon) {
		animation: hop 0.3s steps(2);
	}

	@keyframes hop {
		50% {
			translate: 0 -6px;
		}
	}

	.accounts__handle {
		min-width: 0;
		margin-left: auto;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	@media (max-width: 640px) {
		.note {
			font-family: var(--font-body);
			font-size: 20px;
			line-height: 30px;
		}

		.accounts {
			grid-template-columns: 1fr;
		}
	}
</style>
