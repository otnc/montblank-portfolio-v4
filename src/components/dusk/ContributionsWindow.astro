---
import LanguageBar from '@/components/dusk/LanguageBar.astro';
import StatsColumn from '@/components/dusk/StatsColumn.astro';
import Window from '@/components/dusk/Window.astro';
import type { Contribution } from '@/lib/github';

interface Props {
	contributions: Contribution[] | null;
}

const { contributions } = Astro.props;
---

<Window title="contributions.txt" class="window--left">
	<h2>Contributions</h2>
	<p class="muted">他のリポジトリにマージされたプルリクエストと Issue</p>
	{
		contributions && contributions.length > 0 ? (
			<ul class="repos">
				{contributions.map((repo) => (
					<li class="repo">
						<div class="repo__text">
							<a class="repo__name" href={repo.url} target="_blank" rel="noreferrer">
								<span class="muted">{repo.owner}/</span>
								{repo.name}
							</a>
							<LanguageBar languages={repo.languages.slice(0, 3)} />
						</div>
						<StatsColumn stars={repo.stars} merged={repo.mergedCount} issues={repo.issueCount} />
					</li>
				))}
			</ul>
		) : contributions ? (
			<p class="notice">まだありません。</p>
		) : (
			<p class="notice">GitHub から読み込めませんでした。</p>
		)
	}
</Window>

<style>
	/*
	 * A scrolling list, one repository per row, with its counts in a column on the right.
	 * It is the positioning context for anything absolute inside, so that scrolls with the list instead of stretching the page.
	 */
	.repos {
		position: relative;
		display: grid;
		margin-top: 12px;
		max-height: 660px;
		overflow-y: auto;
	}

	.repo {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 8px;
		border-bottom: 3px dashed var(--marron-light);
	}

	.repo:last-child {
		border-bottom: none;
	}

	.repo:hover,
	.repo:focus-within {
		background: var(--marron-light);
	}

	.repo__text {
		display: grid;
		flex: 1;
		gap: 6px;
		min-width: 0;
	}

	.repo__name {
		color: var(--ink);
		overflow-wrap: anywhere;
	}
</style>
