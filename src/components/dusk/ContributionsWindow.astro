---
import ContributionsList from '@/components/dusk/ContributionsList.astro';
import Loading from '@/components/dusk/Loading.astro';
import Window from '@/components/dusk/Window.astro';
import { profile } from '@/data/profile';
---

<Window title={`/${profile.handle}/contributions/`} class="window--left">
	<h2>Contributions</h2>
	<p class="muted">他のリポジトリにマージされたプルリクエストと Issue</p>
	<ContributionsList server:defer>
		<Loading slot="fallback" height="660px" />
	</ContributionsList>
</Window>

<style is:global>
	/* The list, rendered by the ContributionsList server island. */
	/*
	 * A scrolling list, one repository per row, with its counts in a column on the right.
	 * It is the positioning context for anything absolute inside, so that scrolls with the list instead of stretching the page.
	 */
	.repos {
		position: relative;
		display: grid;
		margin-top: 12px;
		max-height: 660px;
		overflow-y: auto;
	}

	.repo {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 8px;
		border-bottom: 3px dashed var(--marron-light);
	}

	.repo:last-child {
		border-bottom: none;
	}

	.repo:hover,
	.repo:focus-within {
		background: var(--marron-light);
	}

	.repo__text {
		display: grid;
		flex: 1;
		gap: 6px;
		min-width: 0;
	}

	.repo__name {
		color: var(--ink);
		overflow-wrap: anywhere;
	}
</style>
