---
import LanguageBar from '@/components/dusk/LanguageBar.astro';
import Window from '@/components/dusk/Window.astro';
import { formatCompact } from '@/lib/format';
import type { Contribution } from '@/lib/github';

interface Props {
	contributions: Contribution[] | null;
}

const { contributions } = Astro.props;
// As in portfolio-v3, a count of none (or one that could not be read) shows as "-".
const count = (value: number | null) => (value ? formatCompact(value) : '-');
---

<Window title="contributions.txt" class="window--left">
	<h2>Contributions</h2>
	<p class="muted">他のリポジトリにマージされたプルリクエストと Issue</p>
	{
		contributions && contributions.length > 0 ? (
			<ul class="repos">
				{contributions.map((repo) => (
					<li>
						<a class="repo" href={repo.url} target="_blank" rel="noreferrer">
							<span class="repo__name">
								<span class="muted">{repo.owner}/</span>
								{repo.name}
							</span>
							<span class="repo__counts">
								<span title="Stars"><span>★</span><span>{count(repo.stars)}</span></span>
								<span title="Merged pull requests"><span>PR</span><span>{count(repo.mergedCount)}</span></span>
								<span title="Issues opened"><span>Issue</span><span>{count(repo.issueCount)}</span></span>
							</span>
						</a>
						<LanguageBar languages={repo.languages} labelled={3} />
					</li>
				))}
			</ul>
		) : contributions ? (
			<p class="notice">まだありません。</p>
		) : (
			<p class="notice">GitHub から読み込めませんでした。</p>
		)
	}
</Window>

<style>
	.repos {
		display: grid;
		gap: 16px;
		margin-top: 12px;
		max-height: 640px;
		overflow-y: auto;
	}

	.repo {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0 16px;
		padding: 2px 8px;
		color: var(--ink);
		text-decoration: none;
	}

	.repo:hover,
	.repo:focus-visible {
		background: var(--marron-light);
	}

	.repo__name {
		min-width: 0;
		overflow-wrap: anywhere;
		text-decoration: underline;
	}

	/* Fixed, right-aligned columns, so stars, pull requests and issues line up from row to row. */
	.repo__counts {
		display: grid;
		grid-template-columns: 100px 70px 90px;
		gap: 0 30px;
		margin-left: auto;
		white-space: nowrap;
	}

	/* Label on the left, number on the right of each column. */
	.repo__counts > span {
		display: flex;
		justify-content: space-between;
		gap: 6px;
	}
</style>
