---
import GithubSummary from '@/components/dusk/GithubSummary.astro';
import Loading from '@/components/dusk/Loading.astro';
import Window from '@/components/dusk/Window.astro';
import { profile } from '@/data/profile';
---

<Window id="github" title={`github.com/${profile.handle}`} class="window--left">
	<h2>GitHub</h2>
	<GithubSummary server:defer>
		<Loading slot="fallback" height="480px" />
	</GithubSummary>
</Window>

<style is:global>
	/* The numbers and graph, rendered by the GithubSummary server island. */
	.numbers {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 12px;
		margin: 8px 0 24px;
	}

	.numbers div {
		padding: 8px 12px;
		background: var(--marron-light);
	}

	.numbers dt {
		color: var(--muted);
	}

	.numbers dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 24px;
		line-height: 36px;
	}

	.graph-heading {
		margin-top: 24px;
	}

	.graph {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: calc(var(--graph-dots) * var(--dot));
		margin-top: 8px;
		border-bottom: 3px solid var(--ink);
	}

	.graph li {
		flex: 1;
		height: calc(var(--dots) * var(--dot));
		background: var(--accent);
	}
</style>
