---
/**
 * The bay area at dusk along the bottom of the hero (drawn in src/data/bay-view.ts and served as /pixel/bay.svg),
 * with the lights that come on over it: Motomachi windows, warehouse doors, the summit station and the ropeway gondola.
 */
import { BASE, H, QUAY, SUMMIT, SUN, W, doors, windows } from '@/data/bay-view';
---

<div class="bay" aria-hidden="true" style={`--w:${W};--h:${H}`}>
	<div class="bay__stage">
		<img class="bay__art" src="/pixel/bay.svg" width={W * 3} height={H * 3} alt="" fetchpriority="high" />
		{windows.map((w) => <span class="light" style={`left:${w.x * 3}px;top:${w.y * 3}px;--delay:${w.delay}s`} />)}
		{doors.map((door) => <span class="door" style={`left:${door.x * 3}px;top:${door.y * 3}px;--delay:${door.delay}s`} />)}
		<span class="summit" style={`left:${(SUMMIT.x - 4) * 3}px;top:${(SUMMIT.y + 1) * 3}px`} />
		<span
			class="gondola"
			style={`left:${SUMMIT.x * 3}px;top:${SUMMIT.y * 3}px;--dx:${(BASE.x - SUMMIT.x - 2) * 3}px;--dy:${(BASE.y - SUMMIT.y - 2) * 3}px`}
		/>
		{
			Array.from({ length: 8 }, (_, index) => (
				<span
					class="glint"
					style={`left:${(SUN.x - 8 + ((index * 5) % 14)) * 3}px;top:${(QUAY + 3 + index * 2) * 3}px;width:${(3 + index) * 3}px;--delay:${-index * 0.3}s`}
				/>
			))
		}
	</div>
</div>

<style>
	.bay {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: calc(var(--h) * 3px);
		overflow: hidden;
		pointer-events: none;
	}

	.bay__stage {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: calc(var(--w) * 3px);
		height: 100%;
		translate: -50% 0;
	}

	.bay__art {
		position: absolute;
		inset: 0;
	}

	.bay__stage > span {
		position: absolute;
	}

	/* Windows switch on one by one as dusk deepens, then flicker now and then. */
	.light {
		width: 3px;
		height: 3px;
		background: #ffd27a;
		opacity: 0;
		animation: light-on 8s steps(1) var(--delay) infinite;
	}

	@keyframes light-on {
		20%,
		88% {
			opacity: 1;
		}
		90% {
			opacity: 0.3;
		}
		92% {
			opacity: 1;
		}
	}

	/* The warehouses light up from their doorways. */
	.door {
		width: 15px;
		height: 27px;
		background: linear-gradient(transparent 0 33%, #ffb34766 33% 66%, #ffb347aa 66%);
		opacity: 0;
		animation: door-on 1s steps(1) calc(1.5s + var(--delay)) forwards;
	}

	@keyframes door-on {
		to {
			opacity: 1;
		}
	}

	.summit {
		width: 24px;
		height: 3px;
		background: repeating-linear-gradient(90deg, #ffd27a 0 3px, transparent 3px 6px);
		animation: blink 1.6s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0.4;
		}
	}

	/* The ropeway gondola goes up and down the cable in steps. */
	.gondola {
		width: 6px;
		height: 6px;
		background: #c8442f;
		outline: 3px solid #2a1a2a;
		animation: gondola 24s steps(80) infinite alternate;
	}

	@keyframes gondola {
		to {
			translate: var(--dx) var(--dy);
		}
	}

	/* The sun's reflection: short lines that shimmer sideways. */
	.glint {
		height: 3px;
		background: #ffe2a0;
		animation: shimmer 1.6s steps(2) var(--delay) infinite alternate;
	}

	@keyframes shimmer {
		from {
			translate: -6px 0;
			opacity: 0.9;
		}
		to {
			translate: 6px 0;
			opacity: 0.5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bay__stage > span {
			animation: none;
		}

		.light,
		.door {
			opacity: 1;
		}
	}
</style>
