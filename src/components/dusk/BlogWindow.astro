---
import Window from '@/components/dusk/Window.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { writingSites } from '@/data/profile';
import type { Post } from '@/lib/feeds';
import { formatDate } from '@/lib/format';

interface Props {
	posts: Post[] | null;
}

const { posts } = Astro.props;
const siteBySource = new Map(writingSites.map((site) => [site.label, site]));
// As in portfolio-v3, posts from the last week get a "New" label.
const NEW_WITHIN_MS = 7 * 24 * 60 * 60 * 1000;
const isNew = (date: string) => {
	const age = Date.now() - Date.parse(date);
	return age >= 0 && age <= NEW_WITHIN_MS;
};
---

<Window title="feeds/" class="window--right">
	<h2>Blog</h2>
	{
		posts && posts.length > 0 ? (
			<ul class="posts">
				{posts.map((post) => {
					const site = siteBySource.get(post.source);
					return (
						<li>
							<a class="post" href={post.url} target="_blank" rel="noreferrer">
								{site && <PixelIcon name={site.icon} scale={2} />}
								<span class="post__body">
									<span class="post__title">
										{post.date && isNew(post.date) && <span class="post__new">New</span>}
										{post.title}
									</span>
									{post.description && <span class="post__desc muted">{post.description}</span>}
									<span class="post__meta muted">
										{post.source} {formatDate(post.date)}
									</span>
								</span>
							</a>
						</li>
					);
				})}
			</ul>
		) : (
			<p class="notice">記事を読み込めませんでした。</p>
		)
	}
	<ul class="more">
		{
			writingSites.map((site) => (
				<li>
					<a href={site.url} target="_blank" rel="noreferrer">
						<PixelIcon name={site.icon} scale={2} />
						<span>{site.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</Window>

<style>
	/* The positioning context for anything absolute inside, so it scrolls with the list instead of stretching the page. */
	.posts {
		position: relative;
		display: grid;
		gap: 4px;
		margin-top: 8px;
		max-height: 600px;
		overflow-y: auto;
	}

	.post {
		display: flex;
		gap: 12px;
		padding: 8px;
		color: var(--ink);
		text-decoration: none;
	}

	.post:hover,
	.post:focus-visible {
		background: var(--marron-light);
	}

	.post :global(.pixel-icon) {
		flex: none;
		margin-top: 3px;
	}

	.post__body {
		display: grid;
		min-width: 0;
	}

	.post__title {
		text-decoration: underline;
	}

	.post__new {
		display: inline-block;
		margin-right: 8px;
		padding: 0 6px;
		background: var(--maple);
		color: var(--cream);
		text-decoration: none;
		animation: new-blink 1.2s steps(1) infinite;
	}

	@keyframes new-blink {
		50% {
			background: var(--ginkgo);
			color: var(--ink);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post__new {
			animation: none;
		}
	}

	/* Descriptions vary in length, so keep every post to two lines. */
	.post__desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		overflow-wrap: anywhere;
	}

	/* Where each feed comes from, as icon links. */
	.more {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: 16px;
	}

	.more a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
		transition: transform 0.12s steps(2);
	}

	.more a:hover,
	.more a:focus-visible {
		transform: translateY(-3px);
	}
</style>
