---
import BlogPosts from '@/components/dusk/BlogPosts.astro';
import Loading from '@/components/dusk/Loading.astro';
import Window from '@/components/dusk/Window.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { writingSites } from '@/data/profile';
---

<Window title="feeds/" class="window--right">
	<h2>Blog</h2>
	<BlogPosts server:defer>
		<Loading slot="fallback" height="600px" />
	</BlogPosts>
	<ul class="more">
		{
			writingSites.map((site) => (
				<li>
					<a href={site.url} target="_blank" rel="noreferrer">
						<PixelIcon name={site.icon} scale={2} />
						<span>{site.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</Window>

<style>
	/* Where each feed comes from, as icon links. */
	.more {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: 16px;
	}

	.more a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
		transition: transform 0.12s steps(2);
	}

	.more a:hover,
	.more a:focus-visible {
		transform: translateY(-3px);
	}
</style>

<style is:global>
	/* The post list, rendered by the BlogPosts server island. */
	/* The positioning context for anything absolute inside, so it scrolls with the list instead of stretching the page. */
	.posts {
		position: relative;
		display: grid;
		gap: 4px;
		margin-top: 8px;
		max-height: 600px;
		overflow-y: auto;
	}

	.post {
		display: flex;
		gap: 12px;
		padding: 8px;
		color: var(--ink);
		text-decoration: none;
	}

	.post:hover,
	.post:focus-visible {
		background: var(--marron-light);
	}

	.post .pixel-icon {
		flex: none;
		margin-top: 3px;
	}

	.post__body {
		display: grid;
		min-width: 0;
	}

	.post__title {
		text-decoration: underline;
	}

	.post__new {
		display: inline-block;
		margin-right: 8px;
		padding: 0 6px;
		background: var(--maple);
		color: var(--cream);
		text-decoration: none;
		animation: new-blink 1.2s steps(1) infinite;
	}

	@keyframes new-blink {
		50% {
			background: var(--ginkgo);
			color: var(--ink);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post__new {
			animation: none;
		}
	}

	/* Descriptions vary in length, so keep every post to two lines. */
	.post__desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		overflow-wrap: anywhere;
	}
</style>
