---
import AboutWindow from '@/components/dusk/AboutWindow.astro';
import BlogWindow from '@/components/dusk/BlogWindow.astro';
import CareerWindow from '@/components/dusk/CareerWindow.astro';
import ContributionsWindow from '@/components/dusk/ContributionsWindow.astro';
import CrossLinksWindow from '@/components/dusk/CrossLinksWindow.astro';
import GithubWindow from '@/components/dusk/GithubWindow.astro';
import Hero from '@/components/dusk/Hero.astro';
import Marquee from '@/components/dusk/Marquee.astro';
import TramStop from '@/components/dusk/TramStop.astro';
import WorksWindow from '@/components/dusk/WorksWindow.astro';
import DuskLayout from '@/layouts/DuskLayout.astro';
import { profile } from '@/data/profile';
import { orNull } from '@/lib/cache';
import { getPosts } from '@/lib/feeds';
import { getContributions, getGithubStats, getWorks } from '@/lib/github';

// Optional Pages secret: with it GitHub is read through GraphQL, without it through the token-less sources (see src/lib/github-public.ts).
const githubToken = Astro.locals.runtime?.env?.GITHUB_TOKEN;

const [stats, works, contributions, posts] = await Promise.all([
	orNull(getGithubStats(githubToken, profile.handle)),
	orNull(getWorks(githubToken, profile.handle)),
	orNull(getContributions(githubToken, profile.handle)),
	orNull(getPosts()),
]);
---

<DuskLayout path="/" title={`${profile.name}のポートフォリオ`} description={profile.bio}>
	<Hero slot="hero" />
	<Marquee slot="hero" messages={profile.messages} />

	<main id="main" class="page">
		<AboutWindow />
		<BlogWindow posts={posts} />
		<GithubWindow stats={stats} />
		<WorksWindow works={works} />
		<ContributionsWindow contributions={contributions} />
		<CareerWindow />
		<CrossLinksWindow />
		<TramStop />
	</main>
</DuskLayout>
